/* 메인메뉴 — 제목 하나와 선택지 둘을 세로로 쌓는다.
 *
 * **독방 씬 위에 덮이는 층이다.** 배경을 불투명하게 칠하지 않고 어둡게 덮기만 한다 —
 * 뒤로 방과 전등이 비쳐야 고른 순간의 페이드가 "메뉴가 걷히고 방이 드러나는" 것으로
 * 읽힌다. 완전히 가리면 그냥 화면이 바뀐 것이 된다.
 *
 * 이 화면이 쓰는 값은 전부 루트 클래스의 --menu-* 에 모여 있다 (Hud.uss 와 같은 방식).
 * prototype/main-menu.css 가 같은 변수 이름을 쓴다 — 한쪽만 고치면 둘이 어긋난다. */

.main-menu {
    /*메뉴가 방을 덮는 정도. 높이면 글자가 잘 읽히고 방이 지워진다 */
    --menu-scrim: rgba(4, 4, 6, 0.62);
    /*제목 색 — HUD 조준점과 같은 흰색 (완전한 1.0 은 전구 전용) */
    --menu-title-color: rgb(226, 226, 226);
    /*버튼 글자 */
    --menu-text-color: rgb(198, 198, 202);
    /*테두리 — 쉴 때 */
    --menu-line-color: rgb(96, 96, 102);
    /*테두리 — 가리켰을 때 */
    --menu-line-active-color: rgb(226, 226, 226);
    /*표면 — 가리켰을 때 */
    --menu-surface-active: rgba(226, 226, 226, 0.09);

    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: var(--menu-scrim);

    /* 고르면 이 층 전체가 사라진다. 게임 UI(HUD · 모바일 조작)가 같은 동안
       반대로 나타나 두 연출이 겹친다.
       ⚠️ 이 길이는 MainMenuScreen.FadeOutMs 와 같아야 한다 — 스크립트가 이 시간
       뒤에 층을 접고 게임을 시작한다. 짧으면 아직 보이는 채로 접히고, 길면
       투명해진 메뉴가 남아 첫 조작을 먹는다.
       transition 계열은 var() 를 쓰지 않는다 — CLAUDE.md */
    transition-property: opacity;
    transition-duration: 420ms;
    transition-timing-function: ease-out-cubic;
}

.main-menu--hidden {
    opacity: 0;
}

/* 대문자는 문자열 자체로 만든다 — USS 에 text-transform 이 없다.
   자간을 크게 벌려 마퀴 간판처럼 읽히게 한다. */
.main-menu__title {
    font-size: 104px;
    letter-spacing: 18px;
    -unity-font-style: bold;
    color: var(--menu-title-color);
    /* 자간이 마지막 글자 뒤에도 붙어 우로 밀린다. 그만큼 당겨 광학적으로 맞춘다 */
    margin-right: -18px;
    /* gap 이 없다 — 제목과 첫 버튼 사이는 여기서 벌린다 */
    margin-bottom: 72px;
}

.menu-button {
    width: 360px;
    height: 104px;
    align-items: center;
    justify-content: center;

    /* 기본 테마의 Button 여백을 걷어낸다. 크기를 픽셀로 못 박는 버튼이라
       패딩이 남으면 글자가 밀린다 */
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 24px;

    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;              /* USS 는 border 단축 속성이 없다. 항상 나눠 쓴다 */
    border-color: var(--menu-line-color);
    border-radius: 2px;

    color: var(--menu-text-color);
    font-size: 40px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;

    /* transition 계열은 var() 를 쓰지 않는다 — CLAUDE.md */
    transition-property: background-color, border-color, scale;
    transition-duration: 140ms, 140ms, 140ms;
    transition-timing-function: ease-out-cubic, ease-out-cubic, ease-out-cubic;
}

.menu-button:hover {
    background-color: var(--menu-surface-active);
    border-color: var(--menu-line-active-color);
    scale: 1.03;
}

/* 눌린 순간은 살짝 들어간다. 터치에는 hover 가 없어 이게 유일한 확인이다 */
.menu-button:active {
    scale: 0.98;
}
