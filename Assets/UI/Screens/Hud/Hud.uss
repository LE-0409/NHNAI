/* HUD — 조준점.
 *
 * DESIGN.md 가 아직 없어 토큰이 없다. CLAUDE.md 의 로컬 변수 예외를 따라
 * 루트 클래스에 --hud-* 로 두고 승격 후보로 표시해 둔다. 리터럴을 여기저기
 * 흩뿌리면 나중에 토큰으로 올릴 때 어디를 고쳐야 할지 알 수 없다. */

.hud {
    /* 토큰 승격 후보: 조준점 색 — 흰색이지만 완전한 흰색은 아니다. 전구만 1.0 이어야 한다 */
    --hud-reticle-color: rgb(226, 226, 226);
    /* 토큰 승격 후보: 조준점 지름 */
    --hud-reticle-size: 6px;
    /* 토큰 승격 후보: 인벤토리 개수 색 — 조준점과 같은 흰색 (완전한 1.0 은 전구 전용) */
    --hud-coin-count-color: rgb(226, 226, 226);
    /* 토큰 승격 후보: 인벤토리 개수 크기 */
    --hud-coin-count-size: 32px;

    flex-grow: 1;
    align-items: center;
    justify-content: center;

    /* 메인메뉴가 걷히기 전까지는 숨어 있다. 메뉴 위에 조준점이 떠 있으면
       아직 시작하지 않은 게임이 이미 시작한 것처럼 보인다.
       HudScreen.Begin 이 --visible 을 붙여 떠오르게 한다.
       transition 계열은 var() 를 쓰지 않는다 — CLAUDE.md */
    opacity: 0;
    transition-property: opacity;
    transition-duration: 520ms;
    transition-timing-function: ease-out-cubic;
}

.hud--visible {
    opacity: 1;
}

/* 항상 떠 있되 평소에는 희미하고 작다 — 어두운 방을 바라보는 장면을 방해하지
   않으면서도 시선의 중심은 늘 알 수 있어야 한다. 쓸 수 있는 것을 조준하면
   커지고 또렷해진다. */
.hud__reticle {
    width: var(--hud-reticle-size);
    height: var(--hud-reticle-size);
    border-radius: 3px;
    background-color: var(--hud-reticle-color);

    opacity: 0.35;
    scale: 0.7;

    /* transition 계열은 var() 를 쓰지 않는다 — CLAUDE.md 참조 */
    transition-property: opacity, scale;
    transition-duration: 110ms, 110ms;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}

.hud__reticle--active {
    opacity: 1;
    scale: 1;
}

/* 인벤토리 동전 개수 — 우측 하단. 레이아웃 없이 숫자 하나만 띄운다.
   루트가 조준점을 중앙 정렬하고 있으므로 absolute 로 흐름에서 뺀다. */
.hud__coin-count {
    position: absolute;
    bottom: 24px;
    right: 32px;
    color: var(--hud-coin-count-color);
    font-size: var(--hud-coin-count-size);
    -unity-text-align: middle-right;
}

/* 모바일은 우측 하단이 행동 버튼 자리다 (MobileControls.uss 의 .action-pad).
   그대로 두면 '사용' 버튼 뒤에 숨는다. 엄지가 닿지 않는 위로 올린다.
   HudScreen 이 조작 방식을 보고 이 클래스를 붙인다. */
.hud--mobile .hud__coin-count {
    top: 24px;
    bottom: auto;
}
