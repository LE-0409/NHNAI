/* 모바일 조작 — 배치와 버튼.
 *
 * 두 손이 화면 아래 양쪽 구석을 잡는다: 왼손은 조이스틱(이동), 오른손은 행동 버튼.
 * 시점은 오른쪽 넓은 영역 어디를 끌어도 돈다.
 * **화면 가운데는 비운다** — 조준점이 거기 있고, 슬롯머신을 봐야 하는 게임이다.
 *
 * DESIGN.md 가 아직 없어 토큰이 없다. Hud.uss 와 같은 방식으로 루트 클래스에
 * --touch-* 로컬 변수를 두고 승격 후보로 표시한다.
 * **VirtualJoystick.uss · TouchLookPad.uss 가 이 변수들을 상속받아 쓴다** —
 * 정의하는 곳은 여기 하나뿐이다. prototype/README.md 참조. */

.mobile-controls {
    /* 토큰 승격 후보: 조작부 선 — 3D 화면 위에 얹히므로 반투명이다 */
    --touch-line-color: rgba(226, 226, 226, 0.42);
    /* 토큰 승격 후보: 조작부 면 */
    --touch-surface: rgba(10, 10, 12, 0.30);
    /* 토큰 승격 후보: 눌렸을 때의 면 */
    --touch-surface-active: rgba(226, 226, 226, 0.20);
    /* 토큰 승격 후보: 조작부 글자 — HUD 조준점과 같은 흰색 (완전한 1.0 은 전구 전용) */
    --touch-text-color: rgb(226, 226, 226);
    /* 토큰 승격 후보: 조이스틱 손잡이 */
    --touch-knob-color: rgba(226, 226, 226, 0.55);

    flex-grow: 1;
    /* 배경을 칠하지 않는다. 3D 화면 위에 덮이는 층이다 */

    /* 메인메뉴가 걷히기 전까지는 숨어 있다. HUD 와 같은 이유·같은 방식이다
       (Hud.uss 참조). MobileControlsScreen.Begin 이 --visible 을 붙인다.
       ⚠️ display 로 숨기지 않는다 — display:none 이던 요소는 첫 프레임에
       레이아웃이 없어 opacity 트랜지션이 그냥 건너뛴다. 투명하게 깔아 두면
       그 위를 메뉴 층이 덮고 있어 손가락도 닿지 않는다.
       transition 계열은 var() 를 쓰지 않는다 — CLAUDE.md */
    opacity: 0;
    transition-property: opacity;
    transition-duration: 520ms;
    transition-timing-function: ease-out-cubic;
}

.mobile-controls--visible {
    opacity: 1;
}

/* --- 자리 --------------------------------------------------------------- */

/* 오른쪽 넓은 영역. % 로 잡는 이유: 기기마다 패널 논리 크기가 달라 px 로 박으면
   폰에서는 화면 대부분을, 태블릿에서는 일부만 덮는다.
   왼쪽 42% 를 비워 조이스틱과 겹치지 않게 한다. */
.mobile-controls__look-pad {
    position: absolute;
    left: 42%;
    right: 0;
    top: 0;
    bottom: 0;
}

.mobile-controls__joystick {
    position: absolute;
    left: 104px;
    bottom: 104px;
}

/* --- 행동 버튼 ---------------------------------------------------------- */

/* 오른쪽 아래 구석. 큰 버튼(사용)이 엄지 안쪽, 작은 버튼 둘이 그 왼쪽이다 —
   자주 쓰는 것일수록 엄지에 가깝다. */
.action-pad {
    position: absolute;
    right: 88px;
    bottom: 88px;
    flex-direction: row;
    align-items: flex-end;
}

/* gap 이 없다 — 간격은 자식의 margin 이 만든다 */
.action-pad__minor {
    flex-direction: column;
    margin-right: 22px;
}

.action-button {
    align-items: center;
    justify-content: center;

    /* 기본 테마의 Button 여백을 걷어낸다. 크기를 픽셀로 못 박는 버튼이라
       패딩이 남으면 글자가 밀린다 */
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;

    border-width: 1px;              /* USS 는 border 단축 속성이 없다. 항상 나눠 쓴다 */
    border-color: var(--touch-line-color);
    background-color: var(--touch-surface);
    color: var(--touch-text-color);
    -unity-text-align: middle-center;

    /* transition 계열은 var() 를 쓰지 않는다 — CLAUDE.md */
    transition-property: background-color, scale;
    transition-duration: 90ms, 90ms;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}

/* 터치에는 hover 가 없다. 눌린 순간에만 반응한다 —
   손가락이 닿았다는 확인이 화면에 있어야 두 번 누르지 않는다. */
.action-button:active {
    background-color: var(--touch-surface-active);
    scale: 0.94;
}

.action-button--major {
    width: 184px;
    height: 184px;
    border-radius: 92px;
    font-size: 30px;
    letter-spacing: 2px;
}

.action-button--minor {
    width: 136px;
    height: 104px;
    border-radius: 6px;
    font-size: 24px;
    letter-spacing: 1px;
}

/* 세로로 쌓인 버튼 중 **위쪽**에만 붙인다. USS 에 :last-child 가 없어 "마지막만
   빼기" 를 못 하므로, 간격을 넣을 쪽에 명시적 클래스를 준다.
   맨 아래 버튼에까지 margin 이 붙으면 옆의 큰 버튼과 밑변이 어긋난다
   (.action-pad 가 align-items: flex-end 로 밑변을 맞추고 있다). */
.action-button--stacked {
    margin-bottom: 18px;
}

