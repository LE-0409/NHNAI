/* 런타임 테마. PanelSettings 가 이걸 물고, 화면 USS 는 각 UXML 이 <Style> 로 붙인다.
 *
 * 새 **컴포넌트** USS 를 만들면 여기에 @import 를 한 줄 추가한다. 빠뜨리면 스타일이
 * 조용히 안 먹는다 — 이 프로젝트에서 가장 흔한 실수다.
 * 화면(Screens) 전용 USS 는 여기 넣지 않는다. */

@import url("unity-theme://default");

@import url("project://database/Assets/UI/Components/VirtualJoystick/VirtualJoystick.uss");
@import url("project://database/Assets/UI/Components/TouchLookPad/TouchLookPad.uss");
